# Frontend
PORT=5173

# Backend API
API_PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Bot Integration
BOT_SECRET=replace-with-a-long-random-bot-token

# Supabase Backend Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key

# JWT Secret
JWT_SECRET=your-secret-key-change-this

# --- AI / LLM Configuration ---
# Zawadi uses DeepSeek API for essay generation, document analysis, and auto-apply.
# Get your API key at https://platform.deepseek.com
AI_PROVIDER=deepseek
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-chat
# Alternative providers (override AI_PROVIDER):
# openai | anthropic | groq | ollama | lmstudio

# Supabase — Vite only exposes VITE_ prefixed variables to the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_or_anon_key

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment-success

# AI / LLM Configuration
AI_PROVIDER=deepseek
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-chat

# Frontend URL (for redirects from backend)
FRONTEND_URL=http://localhost:5173
