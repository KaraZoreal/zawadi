PORT=5173

# Admin console and bot ingestion
ADMIN_EMAIL=admin@zawadi.app
# Generate with: node -e "const crypto=require('crypto');const s=crypto.randomBytes(16).toString('hex');crypto.scrypt('your-password',s,64,(_,k)=>console.log(`${s}:${k.toString('hex')}`))"
ADMIN_PASSWORD_HASH=
INGEST_API_KEY=replace-with-a-long-random-bot-token

# --- AI / LLM Configuration ---
# Zawadi uses DeepSeek API for essay generation, document analysis, and auto-apply.
# Get your API key at https://platform.deepseek.com
AI_PROVIDER=deepseek
AI_API_KEY=sk-your-deepseek-api-key
AI_MODEL=deepseek-chat
# Alternative providers (override AI_PROVIDER):
# openai | anthropic | groq | ollama | lmstudio

# Supabase Auth and Storage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_or_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_for_server_only

# Paystack
PAYSTACK_SECRET_KEY=sk_tes...xxxx
PAYSTACK_CALLBACK_URL=http://localhost:5173
PAYSTACK_PLUS_MONTHLY_PLAN_CODE=
PAYSTACK_PLUS_ANNUAL_PLAN_CODE=
PAYSTACK_PRO_MONTHLY_PLAN_CODE=
PAYSTACK_PRO_ANNUAL_PLAN_CODE=
PAYSTACK_MENTOR_MONTHLY_PLAN_CODE=
PAYSTACK_MENTOR_ANNUAL_PLAN_CODE=
